{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canting:recognition:n0.1",
  "$ref": "#/$defs/Draft",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Provenance": {
      "enum": [
        "text_observed",
        "photo_observed",
        "name_inference",
        "user_input",
        "database_estimate",
        "unknown"
      ]
    },
    "Name": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 24
        }
      },
      "required": [
        "value",
        "provenance",
        "reviewStatus",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "RawName": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 24
        }
      },
      "required": [
        "value",
        "provenance",
        "reviewStatus",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "Quantity": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 24
        }
      },
      "required": [
        "value",
        "provenance",
        "reviewStatus",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "Ratio": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 24
        }
      },
      "required": [
        "value",
        "provenance",
        "reviewStatus",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "Portion": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 99
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unit": {
                  "enum": [
                    "bowl",
                    "cup",
                    "serving",
                    "ordinal",
                    "unknown",
                    "ml",
                    "g"
                  ]
                },
                "band": {
                  "enum": [
                    "small",
                    "medium",
                    "large",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "unit",
                "band"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 24
        }
      },
      "required": [
        "value",
        "provenance",
        "reviewStatus",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "Range": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000.0
                },
                "max": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000.0
                },
                "unit": {
                  "enum": [
                    "bowl",
                    "cup",
                    "serving",
                    "ml",
                    "g"
                  ]
                },
                "knowledgeVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "estimated": {
                  "const": true
                }
              },
              "required": [
                "min",
                "max",
                "unit",
                "knowledgeVersion",
                "estimated"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 24
        }
      },
      "required": [
        "value",
        "provenance",
        "reviewStatus",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "Box": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    },
    "Asset": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "hash": {
          "$ref": "#/$defs/Hash"
        },
        "crop": {
          "$ref": "#/$defs/Box"
        },
        "capturePhase": {
          "enum": [
            "before",
            "during",
            "after",
            "unknown"
          ]
        }
      },
      "required": [
        "assetId",
        "hash",
        "crop",
        "capturePhase"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/Id"
        },
        "type": {
          "$ref": "#/$defs/Provenance"
        },
        "assetId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "type": "null"
            }
          ]
        },
        "textSpan": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evidenceId",
        "type",
        "assetId",
        "bbox",
        "textSpan"
      ],
      "additionalProperties": false
    },
    "Calculation": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "portionBasis": {
          "enum": [
            "personal_consumed",
            "served_total",
            "per_product_unit",
            "unknown"
          ]
        },
        "portion": {
          "$ref": "#/$defs/Portion"
        },
        "allocationRatio": {
          "$ref": "#/$defs/Ratio"
        },
        "consumedRatio": {
          "$ref": "#/$defs/Ratio"
        },
        "estimateRange": {
          "$ref": "#/$defs/Range"
        },
        "notEaten": {
          "$ref": "#/$defs/NotEaten"
        }
      },
      "required": [
        "active",
        "portionBasis",
        "portion",
        "allocationRatio",
        "consumedRatio",
        "estimateRange",
        "notEaten"
      ],
      "additionalProperties": false
    },
    "NotEaten": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "const": true
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 24
        }
      },
      "required": [
        "value",
        "provenance",
        "reviewStatus",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "Confidence": {
      "type": "object",
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "calibrated": {
          "type": "null"
        },
        "grade": {
          "enum": [
            "candidate",
            "unknown"
          ]
        }
      },
      "required": [
        "raw",
        "calibrated",
        "grade"
      ],
      "additionalProperties": false
    },
    "Component": {
      "type": "object",
      "properties": {
        "componentId": {
          "$ref": "#/$defs/Id"
        },
        "selected": {
          "type": "boolean"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "categoryId": {
          "$ref": "#/$defs/Name"
        },
        "calculation": {
          "$ref": "#/$defs/Calculation"
        },
        "completeness": {
          "enum": [
            "known",
            "partial",
            "unknown"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "componentId",
        "selected",
        "name",
        "categoryId",
        "calculation",
        "completeness",
        "confidence"
      ],
      "additionalProperties": false
    },
    "Product": {
      "type": "object",
      "properties": {
        "productId": {
          "$ref": "#/$defs/Id"
        },
        "selected": {
          "type": "boolean"
        },
        "displayName": {
          "$ref": "#/$defs/Name"
        },
        "rawName": {
          "$ref": "#/$defs/RawName"
        },
        "purchaseQuantity": {
          "$ref": "#/$defs/Quantity"
        },
        "purchaseState": {
          "enum": [
            "purchased",
            "not_evidenced",
            "unknown"
          ]
        },
        "nutritionMode": {
          "enum": [
            "aggregate",
            "children",
            "unknown"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "calculation": {
          "$ref": "#/$defs/Calculation"
        },
        "completeness": {
          "enum": [
            "known",
            "partial",
            "unknown"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "specifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RawName"
          },
          "minItems": 0,
          "maxItems": 12
        }
      },
      "required": [
        "productId",
        "selected",
        "displayName",
        "rawName",
        "purchaseQuantity",
        "purchaseState",
        "nutritionMode",
        "components",
        "calculation",
        "completeness",
        "confidence",
        "specifications"
      ],
      "additionalProperties": false
    },
    "Draft": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "meal-v2.1"
        },
        "draftId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "draftRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sourceKind": {
          "enum": [
            "screenshot",
            "food_photo"
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 0,
          "maxItems": 512
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Product"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "modelVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "promptVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "draftId",
        "requestId",
        "draftRevision",
        "sourceKind",
        "assets",
        "evidence",
        "products",
        "modelVersion",
        "promptVersion"
      ],
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "recognition-n0.1"
        },
        "draftId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "draftRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sourceKind": {
          "enum": [
            "screenshot",
            "food_photo"
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "cloudConsent": {
          "type": "boolean"
        },
        "consentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "parameterHash": {
          "$ref": "#/$defs/Hash"
        },
        "requestTicket": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "draftId",
        "requestId",
        "draftRevision",
        "sourceKind",
        "assets",
        "cloudConsent",
        "consentVersion",
        "parameterHash",
        "requestTicket"
      ],
      "additionalProperties": false
    },
    "Provider": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "unconfigured",
            "mock",
            "external"
          ]
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "credentialRef": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^credential:[A-Za-z0-9_-]{1,80}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery": {
          "enum": [
            "undecided",
            "byok",
            "backend_proxy"
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "thinking": {
          "const": false
        },
        "inputTokenLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        },
        "outputTokenLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1200
        }
      },
      "required": [
        "mode",
        "endpoint",
        "model",
        "credentialRef",
        "delivery",
        "region",
        "thinking",
        "inputTokenLimit",
        "outputTokenLimit"
      ],
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "recognition-n0.1"
        },
        "draftId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "draftRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "state": {
          "enum": [
            "review",
            "empty_food",
            "unavailable",
            "error",
            "cancelled",
            "deleted",
            "expired",
            "processing"
          ]
        },
        "simulated": {
          "type": "boolean"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/Draft"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "anyOf": [
            {
              "enum": [
                "AUTH_REQUIRED",
                "CONSENT_REQUIRED",
                "QUOTA_EXCEEDED",
                "IMAGE_INVALID",
                "UPLOAD_FAILED",
                "PROVIDER_TIMEOUT",
                "PROVIDER_UNAVAILABLE",
                "RESULT_INVALID",
                "NO_FOOD",
                "STALE_DRAFT",
                "RESULT_EXPIRED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "inputTokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "outputTokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "billableAttempts": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "inputTokens",
                "outputTokens",
                "billableAttempts"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "draftId",
        "requestId",
        "draftRevision",
        "assetIds",
        "state",
        "simulated",
        "result",
        "errorCode",
        "usage"
      ],
      "additionalProperties": false
    },
    "Deletion": {
      "type": "object",
      "properties": {
        "draftId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "draftRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "ownContentStatus": {
          "enum": [
            "pending",
            "deleted",
            "failed"
          ]
        },
        "providerDeletionStatus": {
          "enum": [
            "not_sent",
            "requested",
            "confirmed",
            "retained_by_policy",
            "failed",
            "unknown"
          ]
        }
      },
      "required": [
        "draftId",
        "requestId",
        "draftRevision",
        "assetIds",
        "ownContentStatus",
        "providerDeletionStatus"
      ],
      "additionalProperties": false
    },
    "Reservation": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "priceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "billingPeriod": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "billingTimezone": {
          "const": "Asia/Shanghai"
        },
        "projectBudgetId": {
          "$ref": "#/$defs/Id"
        },
        "reservedAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000.0
        },
        "settledAmount": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "const": "CNY"
        },
        "state": {
          "enum": [
            "reserved",
            "unknown",
            "settled",
            "released"
          ]
        }
      },
      "required": [
        "requestId",
        "priceVersion",
        "billingPeriod",
        "billingTimezone",
        "projectBudgetId",
        "reservedAmount",
        "settledAmount",
        "currency",
        "state"
      ],
      "additionalProperties": false
    }
  }
}
